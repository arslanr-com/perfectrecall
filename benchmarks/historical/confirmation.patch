+    if jev.enabled():
+        evidence = {str(item.get("id")): item.get("content", "") for item in items}
+        accepted = []
+        for proposal in proposals:
+            supporting = [evidence[i] for i in proposal["evidence_ids"] if i in evidence]
+            if not supporting:
+                continue
+            state = {"evidence": supporting, "proposal": proposal["body"]}
+            category, _ = jev.choose(state, "Choose the canonical category of state.proposal.",
+                                     {category: category.replace("_", " ") for category in allowed})
+            action, probability = jev.choose(state,
+                "Should this proposal become a durable model-slot update? Use only the supplied evidence.",
+                {"update": "Durable, fully supported by evidence and useful in future sessions",
+                 "keep": "Plausible but insufficient evidence for changing a canonical slot",
+                 "ignore": "Unsupported, transient, irrelevant or sensitive secret"})
+            proposal.update(category=category, action=action, confidence=probability,
+                            reason="jev evidence decision")
+            accepted.append(proposal)
+        return accepted
+    return proposals
